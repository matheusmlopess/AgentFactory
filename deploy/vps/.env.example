# AgentFactory API — production settings for deploy/vps (copy to .env; never commit .env).

# Public hostname of the API (DNS A/AAAA record must point at this server) and the ACME contact.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# 64 hex chars: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# GitHub OAuth App (github.com/settings/developers → New OAuth App)
#   Homepage URL:               the webapp URL
#   Authorization callback URL: https://<API_DOMAIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webapp origin + path (OAuth redirect and device-login links go here) and allowed CORS origins.
WEBAPP_URL=https://app.example.com/AgentFactory
CORS_ORIGINS=https://app.example.com

# Never set AGENTFACTORY_ENV in production (it would allow a weak JWT secret).
