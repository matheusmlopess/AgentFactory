{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode gzip
	# Registry uploads are capped at 20 MB by the API; leave headroom for the multipart envelope.
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy api:8000
}
