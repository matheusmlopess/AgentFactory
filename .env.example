# AgentFactory API — environment variables
# Copy to .env and fill in values before running docker compose up.
# Never commit .env to git.

# GitHub OAuth app credentials (create at github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Redirect URI registered in the GitHub OAuth app
# Local dev:   http://localhost:8000/auth/github/callback
# Production:  https://api.agentfactory.dev/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# The API refuses to start with this placeholder (or anything under 32 chars) unless
# AGENTFACTORY_ENV=dev is set (docker-compose.yml sets it for the local dev stack).
JWT_SECRET=change_me_generate_a_real_secret
# AGENTFACTORY_ENV=dev

# Database: SQLite (the container keeps it on the /data volume). Postgres is not supported yet.
DATABASE_URL=sqlite:///./data/agentfactory.db

# Registry ZIP storage and the public base URL used in download links (https in production)
REGISTRY_STORAGE_DIR=./data/registry
API_PUBLIC_URL=http://localhost:8000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

