# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
*.zip

# OS
.DS_Store

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Webapp artifacts
webapp/node_modules/
webapp/dist/
webapp/*.tsbuildinfo
webapp/*.js
webapp/*.d.ts

# API secrets and runtime data
.env
data/
*.db

# AI Harness — ephemeral & local
.claude/settings.local.json
.ai/adapters/*/settings.local.json
.ai/adapters/*/cache/
.ai/adapters/*/history/
.ai/adapters/*/logs/
.ai/adapters/*/sessions/
.ai/adapters/*/context/

# Runtime state that must never be committed
# - orchestrate evidence (full agent stdout/stderr)
.ai/memory/orchestration-runs/
# - holds the license key
.ai/config/user.json
# - filelock files from manifest writes
*.json.lock
